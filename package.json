{
  "name": "esquadro",
  "version": "1.0.0",
  "description": "esquadro — orçamentos de móveis planejados por metro linear, m² ou unidade, organizados por ambiente; PDF para o cliente sem preços internos.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "build:cena": "esbuild src/cena-login.js --bundle --format=esm --minify --target=es2020 --legal-comments=eof --outfile=public/js/cena-login.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pdfkit": "^0.20.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "esbuild": "^0.28.2",
    "three": "^0.186.1"
  }
}
